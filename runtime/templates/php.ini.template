[PHP]
engine=On
short_open_tag=Off
expose_php=Off
display_errors=On
display_startup_errors=On
log_errors=On
error_log="{{LOG_ROOT}}/php-error.log"
extension_dir="{{PHP_ROOT}}/ext"
date.timezone=UTC
memory_limit=256M
max_execution_time=120
upload_max_filesize=1G
post_max_size=1G
max_input_vars=10000

{{PHP_EXTENSIONS}}

[Session]
session.save_path="{{SESSION_ROOT}}"

[opcache]
{{OPCACHE_SETTINGS}}
