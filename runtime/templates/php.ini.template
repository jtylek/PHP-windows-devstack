[PHP]
engine=On
short_open_tag=Off
expose_php=Off
display_errors=On
display_startup_errors=On
log_errors=On
error_log="{{LOG_ROOT}}/php-error.log"
extension_dir="{{PHP_ROOT}}/ext"
date.timezone=UTC
memory_limit=256M
max_execution_time=120
post_max_size=64M
upload_max_filesize=64M

extension=curl
extension=fileinfo
extension=gd
extension=intl
extension=mbstring
extension=mysqli
extension=openssl
extension=pdo_mysql
extension=sodium
extension=zip

[Session]
session.save_path="{{SESSION_ROOT}}"

[opcache]
zend_extension=opcache
opcache.enable=1
opcache.enable_cli=0
