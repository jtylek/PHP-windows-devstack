<Window x:Class="DevStack.ControlPanel.PortsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Port settings" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Service ports" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="Changes apply after stopping and starting the affected service."
                   Foreground="#667085" Margin="0,5,0,18" TextWrapping="Wrap" />
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Apache HTTP Server" />
                <TextBlock Text="Default: 8080 · Common: 80" Foreground="#667085" Margin="0,3,0,0" />
            </StackPanel>
            <TextBox x:Name="ApachePortTextBox" Grid.Column="1" Padding="7" VerticalContentAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MariaDB" />
                <TextBlock Text="Default: 3307 · Common: 3306" Foreground="#667085" Margin="0,3,0,0" />
            </StackPanel>
            <TextBox x:Name="MariaDbPortTextBox" Grid.Column="1" Padding="7" VerticalContentAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Apply" Padding="16,8" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
