<Window x:Class="DevStack.ControlPanel.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PHP Windows DevStack" SizeToContent="WidthAndHeight"
        MaxWidth="520" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <StackPanel Margin="24">
        <TextBlock Text="PHP Windows DevStack" FontSize="22" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="PHP Windows DevStack is a native, portable Windows development environment for PHP applications. It includes Apache HTTP Server, PHP 8.5, MariaDB, and a desktop control panel." />
        <TextBlock Text="Copyright (c) 2026 by Janusz Tylek" Margin="0,16,0,0" />
        <TextBlock Text="Released under MIT license" Margin="0,2,0,0" />
        <TextBlock Margin="0,2,0,0">
            <Hyperlink Click="RepositoryLink_Click">https://github.com/jtylek/PHP-windows-devstack</Hyperlink>
        </TextBlock>
        <Button Content="OK" IsDefault="True" IsCancel="True" Padding="24,6"
                HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
