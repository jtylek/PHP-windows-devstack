<Window x:Class="DevStack.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHP Windows DevStack" Height="620" Width="1120"
        MinHeight="500" MinWidth="900"
        Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="About" Padding="14,6" Margin="12,0,0,0"
                    VerticalAlignment="Top" Click="About_Click" />
            <StackPanel>
                <TextBlock Text="PHP Windows DevStack" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0">
                    <Hyperlink Click="RepositoryLink_Click">https://github.com/jtylek/PHP-windows-devstack</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="VersionSummary" Foreground="#52606D" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,24,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Apache" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApacheStatus" Text="Stopped" Foreground="#B42318" Margin="0,6,0,0" />
                    <TextBlock x:Name="ApacheEndpoint" Foreground="#667085" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StartApacheButton" Content="▶  Start" Padding="12,6" Margin="0,0,8,0"
                                Click="StartApache_Click" />
                        <Button x:Name="StopApacheButton" Content="■  Stop" Padding="12,6"
                                Click="StopApache_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="MariaDB" FontWeight="SemiBold" />
                    <TextBlock x:Name="MariaDbStatus" Text="Stopped" Foreground="#B42318" Margin="0,6,0,0" />
                    <TextBlock x:Name="MariaDbEndpoint" Foreground="#667085" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StartMariaDbButton" Content="▶  Start" Padding="12,6" Margin="0,0,8,0"
                                Click="StartMariaDb_Click" />
                        <Button x:Name="StopMariaDbButton" Content="■  Stop" Padding="12,6"
                                Click="StopMariaDb_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="SMTP Mail Capture" FontWeight="SemiBold" />
                    <TextBlock x:Name="SmtpCardStatus" Text="Stopped" Foreground="#B42318" Margin="0,6,0,0" />
                    <TextBlock Text="127.0.0.1:25" Foreground="#667085" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="StartSmtpButton" Content="▶  Start" Padding="12,6" Margin="0,0,8,0"
                                Click="StartSmtp_Click" />
                        <Button x:Name="StopSmtpButton" Content="■  Stop" Padding="12,6"
                                Click="StopSmtp_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBox Grid.Row="2" x:Name="LogOutput" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#101828" Foreground="#EAECF0" BorderThickness="0"
                 Padding="12" />

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,8">
            <Button Content="Open PowerShell" Padding="18,9" Margin="0,0,8,0"
                    ToolTip="Open bundled PHP with PHPDevStack's php.ini" Click="OpenPowerShell_Click" />
            <Button Content="PHP extensions" Padding="18,9" Margin="0,0,8,0"
                    Click="PhpExtensions_Click" />
            <Button Content="OPcache settings" Padding="18,9"
                    Click="OpcacheSettings_Click" />
            <Button Content="Port settings" Padding="18,9" Margin="8,0,0,0"
                    Click="PortsSettings_Click" />
            <Button x:Name="SmtpCaptureButton" Content="SMTP Mail Capture" Padding="18,9" Margin="8,0,0,0"
                    Click="SmtpCapture_Click" />
        </WrapPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ChangeRootPasswordButton" Content="Set root password" Padding="18,9" Margin="0,0,8,0"
                    Click="ChangeRootPassword_Click" />
            <Button x:Name="OpenPhpMyAdminButton" Content="Open phpMyAdmin" Padding="18,9" Margin="0,0,8,0"
                    Click="OpenPhpMyAdmin_Click" />
            <Button x:Name="OpenBrowserButton" Content="Open localhost" Padding="18,9" Margin="0,0,8,0"
                    Click="OpenBrowser_Click" />
            <Button x:Name="StopButton" Content="■  Stop all" Padding="18,9" Margin="0,0,8,0"
                    Click="StopAll_Click" />
            <Button x:Name="StartButton" Content="▶  Start all" Padding="18,9"
                    Background="#155EEF" Foreground="White" Click="StartAll_Click" />
            <Button x:Name="QuitButton" Content="Quit" Padding="18,9" Margin="8,0,0,0"
                    Click="Quit_Click" />
        </StackPanel>
    </Grid>
</Window>
