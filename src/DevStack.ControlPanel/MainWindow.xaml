<Window x:Class="DevStack.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PHP Windows DevStack" Height="620" Width="1120"
        MinHeight="540" MinWidth="900"
        Background="#EEF2F6">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header banner -->
        <Border Padding="28,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101828" Offset="0" />
                    <GradientStop Color="#1D4ED8" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About" Style="{StaticResource GhostButton}"
                        Padding="16,7" VerticalAlignment="Top" Click="About_Click" />
                <StackPanel>
                    <TextBlock Text="PHP Windows DevStack" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="VersionSummary" Foreground="#C7D7FE" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Apache -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Apache" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ApacheStatus" Text="Stopped" Foreground="#B42318" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="ApacheEndpoint" Foreground="#667085" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartApacheButton" Content="▶  Start" Style="{StaticResource StartButton}"
                                    MinWidth="84" Margin="0,0,8,0" Click="StartApache_Click" />
                            <Button x:Name="StopApacheButton" Content="■  Stop" Style="{StaticResource StopButton}"
                                    MinWidth="84" Click="StopApache_Click" />
                        </StackPanel>
                        <Separator Margin="0,14,0,10" Background="#EAECF0" />
                        <Button x:Name="ApacheToolsButton" Content="Tools  ▾" Padding="10,5"
                                HorizontalAlignment="Left" Click="ApacheTools_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ApacheToolsMenu" Placement="Bottom">
                                    <MenuItem x:Name="OpenBrowserButton" Header="Open localhost"
                                              Click="OpenBrowser_Click" />
                                    <MenuItem Header="Open PowerShell"
                                              ToolTip="Open bundled PHP with PHPDevStack's php.ini"
                                              Click="OpenPowerShell_Click" />
                                    <Separator />
                                    <MenuItem Header="PHP extensions" Click="PhpExtensions_Click" />
                                    <MenuItem Header="OPcache settings" Click="OpcacheSettings_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- MariaDB -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MariaDB" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="MariaDbStatus" Text="Stopped" Foreground="#B42318" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="MariaDbEndpoint" Foreground="#667085" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartMariaDbButton" Content="▶  Start" Style="{StaticResource StartButton}"
                                    MinWidth="84" Margin="0,0,8,0" Click="StartMariaDb_Click" />
                            <Button x:Name="StopMariaDbButton" Content="■  Stop" Style="{StaticResource StopButton}"
                                    MinWidth="84" Click="StopMariaDb_Click" />
                        </StackPanel>
                        <Separator Margin="0,14,0,10" Background="#EAECF0" />
                        <Button x:Name="MariaDbToolsButton" Content="MariaDB tools  ▾" Padding="10,5"
                                HorizontalAlignment="Left" Click="MariaDbTools_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MariaDbToolsMenu" Placement="Bottom">
                                    <MenuItem x:Name="ChangeRootPasswordButton" Header="Set root password"
                                              Click="ChangeRootPassword_Click" />
                                    <MenuItem x:Name="OpenPhpMyAdminButton" Header="phpMyAdmin"
                                              Click="OpenPhpMyAdmin_Click" />
                                    <Separator />
                                    <MenuItem Header="Memory settings" Click="MariaDbSettings_Click" />
                                    <MenuItem Header="Error log" Click="MariaDbErrorLog_Click" />
                                    <MenuItem Header="Slow log" Click="MariaDbSlowLog_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Mailpit -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Mailpit" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="SmtpCardStatus" Text="Stopped" Foreground="#B42318" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="127.0.0.1:25" Foreground="#667085" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="StartSmtpButton" Content="▶  Start" Style="{StaticResource StartButton}"
                                    MinWidth="84" Margin="0,0,8,0" Click="StartSmtp_Click" />
                            <Button x:Name="StopSmtpButton" Content="■  Stop" Style="{StaticResource StopButton}"
                                    MinWidth="84" Click="StopSmtp_Click" />
                        </StackPanel>
                        <Separator Margin="0,14,0,10" Background="#EAECF0" />
                        <Button x:Name="OpenMailpitButton" Content="Open Mailpit" Padding="10,5"
                                HorizontalAlignment="Left" ToolTip="Open the mail inbox at http://127.0.0.1:8025/"
                                Click="OpenMailpit_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBox Grid.Row="1" x:Name="LogOutput" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="#101828" Foreground="#EAECF0" BorderThickness="0"
                     Padding="12" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Port settings" Padding="20,9" Margin="0,0,8,0" Click="PortsSettings_Click" />
                <Button x:Name="StartButton" Content="▶  Start all" Style="{StaticResource StartButton}"
                        Padding="20,9" Margin="0,0,8,0" Click="StartAll_Click" />
                <Button x:Name="StopButton" Content="■  Stop all" Style="{StaticResource StopButton}"
                        Padding="20,9" Margin="0,0,8,0" Click="StopAll_Click" />
                <Button x:Name="QuitButton" Content="Quit" Padding="20,9" Click="Quit_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
