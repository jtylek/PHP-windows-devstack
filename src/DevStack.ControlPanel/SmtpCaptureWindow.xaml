<Window x:Class="DevStack.ControlPanel.SmtpCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMTP Mail Capture" Height="620" Width="980"
        MinHeight="450" MinWidth="720" Background="#F5F7FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="StartButton" Content="Start capture" Padding="14,7" Margin="0,0,8,0" Click="Start_Click" />
                <Button x:Name="StopButton" Content="Stop capture" Padding="14,7" Click="Stop_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SMTP Mail Capture" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Captured messages are stored locally and are never delivered." Foreground="#667085" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Refresh" Padding="12,6" Click="Refresh_Click" />
                        <Button Content="Delete selected" Padding="12,6" Margin="8,0,0,0" Click="DeleteSelected_Click" />
                        <Button Content="Delete all" Padding="12,6" Margin="8,0,0,0" Click="DeleteAll_Click" />
                    </StackPanel>
                    <ListBox x:Name="MessagesList" DisplayMemberPath="DisplayName" SelectionChanged="MessagesList_SelectionChanged" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#101828" Padding="12">
                <TextBox x:Name="MessageContent" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="#101828" Foreground="#EAECF0" BorderThickness="0" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export .eml" Padding="14,7" Margin="0,0,8,0" Click="Export_Click" />
            <Button Content="Close" Padding="14,7" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
